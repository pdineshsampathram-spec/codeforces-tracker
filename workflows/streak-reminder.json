{
  "name": "CodeforcesPro — Streak At Risk Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger (Nightly 8 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://codeforces-tracker-nine.vercel.app/api/automation/users-at-risk",
        "options": {}
      },
      "id": "2",
      "name": "Fetch Users At Risk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.usersAtRisk",
        "options": {}
      },
      "id": "3",
      "name": "Item List Split",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://codeforces-tracker-nine.vercel.app/api/automation/send-alert",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "🔥 Streak At Risk Alert"
            },
            {
              "name": "message",
              "value": "Attention {{ $json.handle }}: You haven't solved a problem on Codeforces in {{ $json.hoursSinceLastSolve }} hours! Solve 1 problem today to keep your streak alive."
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Dispatch Alert Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (Nightly 8 PM)": {
      "main": [[{ "node": "Fetch Users At Risk", "type": "main", "index": 0 }]]
    },
    "Fetch Users At Risk": {
      "main": [[{ "node": "Item List Split", "type": "main", "index": 0 }]]
    },
    "Item List Split": {
      "main": [[{ "node": "Dispatch Alert Webhook", "type": "main", "index": 0 }]]
    }
  }
}
